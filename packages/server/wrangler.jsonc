{
  // Zajel Bootstrap Server - Cloudflare Worker Configuration
  // Purpose: VPS server discovery and attestation authority
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zajel-signaling",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",

  // Durable Objects for server registry and attestation
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVER_REGISTRY",
        "class_name": "ServerRegistryDO"
      },
      {
        "name": "ATTESTATION_REGISTRY",
        "class_name": "AttestationRegistryDO"
      },
      {
        "name": "TUF_METADATA",
        "class_name": "TufMetadataDO"
      },
      {
        "name": "AUDIT_LOG",
        "class_name": "AuditLogDO"
      }
    ]
  },

  // Threshold signing secrets (set via `wrangler secret put`):
  //   OPERATOR_PUBLIC_KEYS        - Comma-separated base64 Ed25519 operator public keys
  //   ADMIN_THRESHOLD             - Number of operator signatures required (default: 2)
  //   REQUIRE_REGISTRATION_AUTH   - 'true' to require signed registrations (default: false)
  //   REQUIRE_HEARTBEAT_AUTH      - 'true' to require signed heartbeats (default: false)
  //   AUDIT_LOG_SECRET            - Bearer token for reading audit log
  //   AUDIT_LOG_INTERNAL_TOKEN    - Internal token for audit log POST endpoint

  // TUF role signing keys (set via `wrangler secret put`):
  //   TARGETS_SIGNING_KEY    - Hex-encoded Ed25519 seed for targets role
  //   TARGETS_PUBLIC_KEY     - Base64-encoded Ed25519 public key for targets role
  //   SNAPSHOT_SIGNING_KEY   - Hex-encoded Ed25519 seed for snapshot role
  //   SNAPSHOT_PUBLIC_KEY    - Base64-encoded Ed25519 public key for snapshot role
  //   TIMESTAMP_SIGNING_KEY  - Hex-encoded Ed25519 seed for timestamp role
  //   TIMESTAMP_PUBLIC_KEY   - Base64-encoded Ed25519 public key for timestamp role
  //   TUF_UPDATE_SECRET      - Bearer token for authenticating PUT /tuf/:role requests

  // Migrations for Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["SignalingRoom"]
    },
    {
      "tag": "v2",
      "new_classes": ["RelayRegistryDO"]
    },
    {
      "tag": "v3",
      "new_classes": ["ServerRegistryDO"],
      "deleted_classes": ["SignalingRoom", "RelayRegistryDO"]
    },
    {
      "tag": "v4",
      "new_classes": ["AttestationRegistryDO"]
    },
    {
      "tag": "v5-tuf-metadata",
      "new_classes": ["TufMetadataDO"]
    },
    {
      "tag": "v6",
      "new_classes": ["AuditLogDO"]
    },
    {
      // v7: DO sharding - no class changes needed.
      // Sharding is implemented via naming (idFromName('region:us-east') vs idFromName('global')).
      "tag": "v7",
      "renamed_classes": []
    }
  ],

  // Custom domain for production
  "routes": [
    { "pattern": "signal.zajel.hamzalabs.dev", "custom_domain": true }
  ],

  // Development settings
  "dev": {
    "port": 8080,
    "local_protocol": "http"
  },

  // QA Environment for PR testing
  "env": {
    "qa": {
      "name": "zajel-signaling-qa",
      "durable_objects": {
        "bindings": [
          {
            "name": "SERVER_REGISTRY",
            "class_name": "ServerRegistryDO"
          },
          {
            "name": "ATTESTATION_REGISTRY",
            "class_name": "AttestationRegistryDO"
          },
          {
            "name": "TUF_METADATA",
            "class_name": "TufMetadataDO"
          },
          {
            "name": "AUDIT_LOG",
            "class_name": "AuditLogDO"
          }
        ]
      },
      "routes": [
        { "pattern": "signal.zajel.qa.hamzalabs.dev", "custom_domain": true }
      ]
    }
  }
}
