  <name>Zajel</name>
  <summary>Private peer-to-peer encrypted messaging</summary>
  <description>
    <p>
      Zajel (Arabic for "carrier pigeon") enables secure, private messaging
      between devices using end-to-end encryption with X25519 key exchange
      and ChaCha20-Poly1305 authenticated encryption.
    </p>
    <p>Features include:</p>
    <ul>
      <li>Direct peer-to-peer connections via WebRTC</li>
      <li>Pairing via codes or QR scanning</li>
      <li>Encrypted file transfer</li>
      <li>Channels (broadcast, polls, live streaming)</li>
      <li>Groups (mesh P2P with sender key encryption)</li>
      <li>Voice and video calls</li>
      <li>Zero-knowledge servers that never see message content</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.zajel.zajel.desktop</launchable>
  <url type="homepage">https://zajel.app</url>
