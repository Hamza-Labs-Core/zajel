{
  // Zajel Diagnostics Collection Worker
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zajel-diagnostics",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",

  // D1 database for aggregated metrics
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zajel-diagnostics",
      "database_id": "50053b5e-b18f-40c7-abab-4d2e58bc9f7d",
      "migrations_dir": "migrations"
    }
  ],

  // R2 bucket for raw diagnostic reports
  "r2_buckets": [
    {
      "binding": "REPORTS_BUCKET",
      "bucket_name": "zajel-diagnostics"
    }
  ],

  // KV namespace for session rate limiting (10 per hour per session)
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "4771816fd0cc469383de67257280c516"
    }
  ],

  // Native rate limiting for global DDoS protection
  "ratelimits": [
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 167,
        "period": 60
      }
    }
  ],

  // Development settings
  "dev": {
    "port": 8790,
    "local_protocol": "http"
  },

  // Production vars
  "vars": {
    "ENVIRONMENT": "production"
  },

  // QA Environment
  "env": {
    "qa": {
      "name": "zajel-diagnostics-qa",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zajel-diagnostics-qa",
          "database_id": "5093d39a-2f31-4e7f-981b-a39f9523bded",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "REPORTS_BUCKET",
          "bucket_name": "zajel-diagnostics-qa"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "RATE_LIMIT_KV",
          "id": "7da4b66fae594a0e9e5af8ef1e0d698d"
        }
      ],
      "ratelimits": [
        {
          "name": "GLOBAL_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 167,
            "period": 60
          }
        }
      ],
      "vars": {
        "ENVIRONMENT": "qa"
      }
    }
  }
}
