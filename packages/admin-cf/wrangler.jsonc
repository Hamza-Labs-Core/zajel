{
  // Zajel Admin Dashboard - Cloudflare Worker Configuration
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zajel-admin",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",

  // Durable Objects for admin user management and notifications
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMIN_USERS",
        "class_name": "AdminUsersDO"
      },
      {
        "name": "NOTIFICATION_DO",
        "class_name": "NotificationDO"
      }
    ]
  },

  // Migrations for Durable Objects
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["AdminUsersDO"]
    },
    {
      "tag": "v2",
      "new_classes": ["NotificationDO"]
    }
  ],

  // Service binding to the bootstrap server (avoids CF-to-CF 530 errors)
  "services": [
    {
      "binding": "BOOTSTRAP_SERVICE",
      "service": "zajel-signaling"
    }
  ],

  // D1 database for reading diagnostics data (error_aggregates)
  "d1_databases": [
    {
      "binding": "DIAGNOSTICS_DB",
      "database_name": "zajel-diagnostics",
      "database_id": "placeholder-d1-id"
    }
  ],

  // Email Workers binding for sending notification emails (unrestricted mode)
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],

  // KV namespace for cooldown state (email/webhook rate limiting)
  "kv_namespaces": [
    {
      "binding": "ADMIN_KV",
      "id": "placeholder-kv-id"
    }
  ],

  // Secrets (already exists in secret store as ZAJEL_ADMIN_JWT_SECRET)
  // The secret is automatically available as env.ZAJEL_ADMIN_JWT_SECRET
  // To update: wrangler secret put ZAJEL_ADMIN_JWT_SECRET

  // Development settings
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  },

  // Custom domain for production
  "routes": [
    { "pattern": "admin.zajel.hamzalabs.dev", "custom_domain": true }
  ],

  // Cron trigger for alert engine evaluation (every 5 minutes)
  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Production vars
  "vars": {
    "ZAJEL_BOOTSTRAP_URL": "https://signal.zajel.hamzalabs.dev",
    "ADMIN_ALLOWED_ORIGINS": "https://admin.zajel.hamzalabs.dev"
  },

  // QA Environment for PR testing
  "env": {
    "qa": {
      "name": "zajel-admin-qa",
      "durable_objects": {
        "bindings": [
          {
            "name": "ADMIN_USERS",
            "class_name": "AdminUsersDO"
          },
          {
            "name": "NOTIFICATION_DO",
            "class_name": "NotificationDO"
          }
        ]
      },
      // Service binding for QA (references the QA bootstrap worker)
      "services": [
        {
          "binding": "BOOTSTRAP_SERVICE",
          "service": "zajel-signaling-qa"
        }
      ],
      // D1 database for QA diagnostics data
      "d1_databases": [
        {
          "binding": "DIAGNOSTICS_DB",
          "database_name": "zajel-diagnostics-qa",
          "database_id": "placeholder-d1-qa-id"
        }
      ],
      // Email Workers binding for QA
      "send_email": [
        {
          "name": "SEND_EMAIL"
        }
      ],
      // KV namespace for QA cooldown state
      "kv_namespaces": [
        {
          "binding": "ADMIN_KV",
          "id": "placeholder-kv-qa-id"
        }
      ],
      // Cron trigger for QA alert engine
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "routes": [
        { "pattern": "admin.zajel.qa.hamzalabs.dev", "custom_domain": true }
      ],
      "vars": {
        "ZAJEL_BOOTSTRAP_URL": "https://signal.zajel.qa.hamzalabs.dev",
        "ADMIN_ALLOWED_ORIGINS": "https://admin.zajel.qa.hamzalabs.dev,http://localhost:*"
      }
    }
  }
}
