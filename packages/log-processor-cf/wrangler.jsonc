{
  // Zajel Log Processor Worker
  // Cron-triggered worker for error pattern analysis and GitHub issue creation
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zajel-log-processor",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",

  // Cron trigger every 15 minutes
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // Shared D1 database (same as diagnostics-cf)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zajel-diagnostics",
      "database_id": "50053b5e-b18f-40c7-abab-4d2e58bc9f7d",
      "migrations_dir": "migrations"
    }
  ],

  // R2 bucket for fetching sample reports
  "r2_buckets": [
    {
      "binding": "REPORTS_BUCKET",
      "bucket_name": "zajel-diagnostics"
    }
  ],

  // Workers AI binding
  "ai": {
    "binding": "AI"
  },

  // Production vars
  "vars": {
    "GITHUB_REPO": "Hamza-Labs-Core/zajel",
    "ENVIRONMENT": "production"
  },

  // QA Environment
  "env": {
    "qa": {
      "name": "zajel-log-processor-qa",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "zajel-diagnostics-qa",
          "database_id": "5093d39a-2f31-4e7f-981b-a39f9523bded",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "REPORTS_BUCKET",
          "bucket_name": "zajel-diagnostics-qa"
        }
      ],
      "vars": {
        "GITHUB_REPO": "Hamza-Labs-Core/zajel",
        "ENVIRONMENT": "qa"
      }
    }
  }
}
